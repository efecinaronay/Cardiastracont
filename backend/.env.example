# ==========================================
# Cardiastracont Backend Configuration
# ==========================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True

# AI Engine Configuration:
# You can use NVIDIA NIM API (build.nvidia.com) OR Google Gemini API OR OpenAI
# (If left empty, Cardiastracont runs in offline autonomous medical flight surgeon mode)

# 1. NVIDIA NIM API:
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_TIMEOUT_SECONDS=25.0
NVIDIA_MAX_RPM=40

# 2. (Optional) Google Gemini API:
GEMINI_API_KEY=

# 3. (Optional) OpenAI / OpenRouter API:
OPENAI_API_KEY=

# Space Medical Safety Thresholds
THRESHOLD_HR_MIN=45.0
THRESHOLD_HR_MAX=125.0
THRESHOLD_OXYGEN_MIN=92.0
THRESHOLD_STRESS_MAX=80.0
THRESHOLD_CO2_PPM_MAX=1000.0

# Anomaly Cooldown in seconds (prevent AI alert spamming)
ALERT_COOLDOWN_SECONDS=1.5
